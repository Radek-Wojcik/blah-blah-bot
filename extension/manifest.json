{
  "manifest_version": 3,
  "name": "Blah Blah Bot",
  "version": "0.6.0",
  "description": "Streams the audio of a browser tab to the Blah Blah Bot application on this computer (127.0.0.1) and reports Google Meet calls.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabCapture", "offscreen", "activeTab", "storage", "tabGroups"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Blah Blah Bot: capture this tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Open the Blah Blah Bot popup"
    },
    "capture-tab": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Capture or stop capturing the current tab"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*"
  }
}
