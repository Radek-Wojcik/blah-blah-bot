{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Radek-Wojcik/blah-blah-bot/schemas/meeting.schema.json",
  "title": "Meeting draft",
  "description": "Structured result of a meeting (work/draft.json, later meeting.json in the cycle repository). All times are milliseconds on the session clock.",
  "type": "object",
  "required": ["version", "meeting_id", "cycle", "date", "language", "mode", "template", "meeting_type", "sections", "summary", "items", "warnings"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "meeting_id": { "type": "string", "minLength": 1 },
    "cycle": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "language": { "enum": ["pl", "en"], "description": "Resolved output language" },
    "mode": { "enum": ["fixed", "template", "auto", "by-type"] },
    "template": { "type": ["string", "null"] },
    "meeting_type": { "type": ["string", "null"] },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" },
    "short_title": {
      "type": "string",
      "description": "Concise 3 to 8 word title derived from the summary or top decision/topic (at most 70 characters)."
    },
    "key_screenshots": {
      "type": "array",
      "description": "Selected distinct, high-information screenshot filenames from the meeting.",
      "items": { "type": "string", "minLength": 1 }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "text", "assignee", "due", "certainty", "section", "relates_to", "source", "edited"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["task", "decision", "topic", "note", "idea", "budget"] },
          "text": { "type": "string", "minLength": 1 },
          "assignee": { "type": ["string", "null"] },
          "assignee_name": { "type": ["string", "null"], "minLength": 1, "description": "Spoken name of a named person not in Participants, or null" },
          "due": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "certainty": {
            "type": "object",
            "required": ["assignee", "due"],
            "additionalProperties": false,
            "properties": {
              "assignee": { "enum": ["stated", "inferred", "unknown"] },
              "due": { "enum": ["stated", "inferred", "unknown"] }
            }
          },
          "section": { "type": ["string", "null"], "description": "Section id; null means the built-in section of the item type (fixed mode) or the last section" },
          "relates_to": { "type": ["string", "null"] },
          "source": {
            "type": ["object", "null"],
            "description": "null for items added by hand",
            "required": ["track", "speaker", "t_start_ms", "t_end_ms", "quote", "verified", "match"],
            "additionalProperties": false,
            "properties": {
              "track": { "type": "string" },
              "speaker": { "type": "string" },
              "t_start_ms": { "type": "integer", "minimum": 0 },
              "t_end_ms": { "type": "integer", "minimum": 0 },
              "quote": { "type": "string" },
              "verified": { "type": "boolean" },
              "match": { "type": "number", "minimum": 0, "maximum": 1, "description": "Similarity of the quote to the best matching transcript text" }
            }
          },
          "edited": { "type": "boolean" }
        }
      }
    },
    "status_proposals": {
      "type": "array",
      "description": "Proposed status changes of open issues or topics, decided by the user in the draft view. Optional: drafts without proposals are valid and do not carry the key.",
      "items": {
        "type": "object",
        "required": ["id", "target", "status", "reason", "comment", "source", "decision", "edited"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]+$" },
          "target": { "type": "string", "minLength": 1, "description": "An open issue (for example #12) or a topic id" },
          "status": { "enum": ["done", "open"] },
          "reason": { "type": "string", "description": "Why the model thinks the status changed" },
          "comment": { "type": ["string", "null"], "description": "Text posted with the change; null until the user writes one" },
          "source": {
            "type": ["object", "null"],
            "description": "null for proposals added by hand",
            "required": ["track", "speaker", "t_start_ms", "t_end_ms", "quote", "verified", "match"],
            "additionalProperties": false,
            "properties": {
              "track": { "type": "string" },
              "speaker": { "type": "string" },
              "t_start_ms": { "type": "integer", "minimum": 0 },
              "t_end_ms": { "type": "integer", "minimum": 0 },
              "quote": { "type": "string" },
              "verified": { "type": "boolean" },
              "match": { "type": "number", "minimum": 0, "maximum": 1, "description": "Similarity of the quote to the best matching transcript text" }
            }
          },
          "decision": { "enum": ["proposed", "approved", "rejected"] },
          "edited": { "type": "boolean" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "enum": ["window_skipped", "quote_unverified", "assignee_unknown", "summary_failed"] },
          "message": { "type": "string" },
          "t_start_ms": { "type": ["integer", "null"] },
          "t_end_ms": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
