{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Radek-Wojcik/blah-blah-bot/schemas/cycle.schema.json",
  "title": "Cycle",
  "description": "cycles/<ID>/cycle.yaml in the cycle repository, converted from YAML to JSON before validation.",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "language": { "enum": ["auto", "pl", "en"] },
    "publish": {
      "enum": ["auto", "on-approval", "off"],
      "description": "When to publish to this target. Optional: when the key is absent the project uses the global rule of Settings > Preferences > When to publish."
    },
    "credential": {
      "type": "string",
      "description": "Reference to a secret in the Windows Credential Manager, never the secret itself",
      "pattern": "^cred:[A-Za-z0-9][A-Za-z0-9_./-]*$"
    },
    "snowflake": { "type": "string", "pattern": "^[0-9]{1,25}$" },
    "notion_id": {
      "type": "string",
      "description": "A Notion database or data source id: 32 hex digits, with or without dashes",
      "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
    },
    "notion_property": { "type": "string", "minLength": 1, "maxLength": 100 }
  },
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1 },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr": { "$ref": "#/$defs/language" },
        "output": { "$ref": "#/$defs/language" }
      }
    },
    "participants": {
      "type": "array",
      "description": "Participant ids must be unique within the cycle (checked after schema validation)",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "github": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
          "discord": {
            "type": "object",
            "description": "Exactly one of user_id and role_id; quote the number so YAML keeps it a string",
            "additionalProperties": false,
            "properties": {
              "user_id": { "$ref": "#/$defs/snowflake" },
              "role_id": { "$ref": "#/$defs/snowflake" }
            },
            "oneOf": [{ "required": ["user_id"] }, { "required": ["role_id"] }]
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "hint": { "type": "string" }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_mode": { "enum": ["fixed", "template", "auto", "by-type"] },
        "default_template": { "$ref": "#/$defs/identifier" },
        "instruction": { "type": "string" },
        "by_type": {
          "type": "object",
          "description": "Meeting type to template name",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$" },
            "publish": { "$ref": "#/$defs/publish" },
            "issues": { "type": "boolean", "description": "Create GitHub issues for task items and write back status changes. Default true." }
          }
        },
        "discord": {
          "type": "object",
          "description": "Exactly one of webhook and bot",
          "additionalProperties": false,
          "properties": {
            "webhook": { "$ref": "#/$defs/credential" },
            "bot": {
              "type": "object",
              "required": ["token", "guild", "channel"],
              "additionalProperties": false,
              "properties": {
                "token": { "$ref": "#/$defs/credential" },
                "guild": { "$ref": "#/$defs/snowflake" },
                "channel": { "$ref": "#/$defs/snowflake" },
                "thread": { "type": "boolean", "description": "One thread per meeting under the summary. Default true." },
                "edit_on_correction": { "type": "boolean", "description": "Edit the summary when a correction is published. Default true." }
              }
            },
            "publish": { "$ref": "#/$defs/publish" },
            "template": { "$ref": "#/$defs/identifier" }
          },
          "oneOf": [{ "required": ["webhook"] }, { "required": ["bot"] }]
        },
        "notion": {
          "type": "object",
          "required": ["token", "database"],
          "additionalProperties": false,
          "properties": {
            "token": { "$ref": "#/$defs/credential" },
            "database": { "$ref": "#/$defs/notion_id" },
            "data_source": { "$ref": "#/$defs/notion_id" },
            "publish": { "$ref": "#/$defs/publish" },
            "properties": {
              "type": "object",
              "description": "Names of Notion properties; status_value is required when status is set (checked after schema validation)",
              "additionalProperties": false,
              "properties": {
                "title": { "$ref": "#/$defs/notion_property" },
                "key": { "$ref": "#/$defs/notion_property" },
                "assignee": { "$ref": "#/$defs/notion_property" },
                "due": { "$ref": "#/$defs/notion_property" },
                "status": { "$ref": "#/$defs/notion_property" },
                "status_value": { "$ref": "#/$defs/notion_property" },
                "meeting": { "$ref": "#/$defs/notion_property" },
                "cycle": { "$ref": "#/$defs/notion_property" }
              }
            }
          }
        }
      }
    }
  }
}
