{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Radek-Wojcik/blah-blah-bot/schemas/cycle-context.schema.json",
  "title": "Cycle context",
  "description": "Everything the extraction needs to know about the cycle, written by the application to work/context.json before the extract stage.",
  "type": "object",
  "required": ["version", "cycle", "name", "meeting_date", "participants", "glossary", "instruction", "output_language", "mode", "template", "meeting_type", "sections", "open_topics", "open_issues", "previous_items"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "cycle": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "meeting_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term"],
        "additionalProperties": false,
        "properties": { "term": { "type": "string", "minLength": 1 }, "hint": { "type": "string" } }
      }
    },
    "instruction": { "type": "string" },
    "output_language": { "enum": ["auto", "pl", "en"] },
    "mode": { "enum": ["fixed", "template", "auto", "by-type"] },
    "template": { "type": ["string", "null"] },
    "meeting_type": { "type": ["string", "null"] },
    "sections": {
      "type": "array",
      "description": "Sections items may be assigned to (empty in fixed and auto mode: fixed uses item types, auto proposes sections in reduce)",
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "open_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "For example #12" },
          "title": { "type": "string" },
          "assignee": { "type": ["string", "null"] }
        }
      }
    },
    "previous_items": {
      "type": "array",
      "description": "Items of earlier meetings of the cycle, newest first, capped",
      "items": {
        "type": "object",
        "required": ["meeting", "type", "text"],
        "additionalProperties": false,
        "properties": {
          "meeting": { "type": "string", "description": "Date of the earlier meeting" },
          "type": { "enum": ["task", "decision", "topic", "note", "idea", "budget"] },
          "text": { "type": "string" },
          "assignee": { "type": ["string", "null"] },
          "due": { "type": ["string", "null"] },
          "issue": { "type": ["string", "null"], "description": "The GitHub issue created for this item, for example #12" }
        }
      }
    },
    "corrections": {
      "type": "array",
      "description": "Notes written after earlier meetings were published; they replace what the items of those meetings say. Newest first, capped. Optional: absent when there are none.",
      "items": {
        "type": "object",
        "required": ["meeting", "date", "text"],
        "additionalProperties": false,
        "properties": {
          "meeting": { "type": "string", "description": "Date of the meeting that is corrected" },
          "date": { "type": "string", "description": "The day the correction was written" },
          "text": { "type": "string" },
          "item": { "type": ["string", "null"], "description": "Text of the item of that meeting that is corrected, when the note is about one" },
          "issue": { "type": ["string", "null"], "description": "The issue it is about, for example #12" }
        }
      }
    }
  }
}
