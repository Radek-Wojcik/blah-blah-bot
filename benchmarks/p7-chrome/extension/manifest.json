{
  "manifest_version": 3,
  "name": "BBB P7 tab capture prototype",
  "version": "0.1.0",
  "description": "Prototype P7: streams tab audio as PCM 16 kHz mono to a local WebSocket (127.0.0.1).",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabCapture", "offscreen", "activeTab", "storage"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture this tab (P7)",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*"
  }
}
