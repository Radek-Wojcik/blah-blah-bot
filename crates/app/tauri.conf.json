{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blah Blah Bot",
  "version": "0.7.0",
  "identifier": "com.github.radek-wojcik.blah-blah-bot",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Blah Blah Bot",
        "url": "index.html?view=main",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "widget",
        "title": "Recorder",
        "url": "index.html?view=widget",
        "width": 340,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:; base-uri 'none'; form-action 'none'; object-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Radoslaw Wojcik",
    "copyright": "Copyright (c) 2026 Radoslaw Wojcik",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Local meeting recorder with transcripts, speakers and reports",
    "longDescription": "Records a meeting on this computer, transcribes it, tells the speakers apart and drafts a report. Models run locally; nothing leaves the machine unless you publish a report.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
